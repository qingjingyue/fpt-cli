// package.json 配置说明
// 注意：实际使用时请删除注释，JSON 格式不支持注释

{
  // 项目基本信息
  "name": "", // 包名称，发布到 npm 时的名称
  "version": "1.0.0", // 版本号，遵循语义化版本规范
  "description": "", // 项目描述
  "main": "index.js", // 入口文件路径
  "type": "module", // 使用 ES 模块系统

  // CLI 命令配置
  "bin": {
    "procli": "./bin/cli.js" // 定义命令行工具入口，安装后可通过 cli 命令使用
  },

  // npm 脚本命令
  "scripts": {
    "test": "jest", // 运行测试
    "lint": "eslint .", // 代码检查
    "format": "prettier --write .", // 代码格式化
    "release": "standard-version" // 自动发布版本
  },

  // 关键词，用于 npm 搜索
  "keywords": [],

  // 作者信息
  "author": "", // 作者名称

  // 开源协议
  "license": "MIT", // MIT 开源协议

  // 生产环境依赖
  "dependencies": {
    "commander": "^11.1.0", // 命令行参数解析框架
    "inquirer": "^9.2.0", // 交互式命令行界面
    "chalk": "^5.3.0", // 终端颜色输出
    "ora": "^7.0.0", // 优雅的加载动画
    "fs-extra": "^11.2.0", // 增强的文件系统操作
    "handlebars": "^4.7.8", // 模板引擎
    "glob": "^10.3.0", // 文件模式匹配
    "axios": "^1.6.0" // HTTP 客户端，用于下载远程模板
  },

  // 开发环境依赖
  "devDependencies": {
    "jest": "^29.7.0", // 测试框架
    "eslint": "^8.56.0", // 代码检查工具
    "prettier": "^3.1.0", // 代码格式化工具
    "standard-version": "^9.5.0" // 自动版本管理和 CHANGELOG 生成
  },

  // 运行环境要求
  "engines": {
    "node": ">=16.0.0", // 最低 Node.js 版本
    "npm": ">=8.0.0" // 最低 npm 版本
  },

  // 发布到 npm 时包含的文件
  "files": [
    "bin", // 可执行文件
    "commands", // 命令模块
    "templates", // 模板文件
    "utils", // 工具函数
    "config", // 配置文件
    "core", // 核心逻辑
    "package.json", // 包配置
    "README.md" // 说明文档
  ],

  // 代码仓库信息
  "repository": {
    "type": "git", // 仓库类型
    "url": "" // 仓库地址
  },

  // 问题反馈地址
  "bugs": {
    "url": "" // Issues 地址
  },

  // 项目主页
  "homepage": "" // 项目主页地址
}
